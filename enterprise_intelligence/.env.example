# Environment variables for the Enterprise Intelligence application
# Copy this file to .env and fill in your actual values

# --- OpenAI / Ollama Configuration ---
# URL to your LLM provider (local Ollama or OpenAI compatible endpoint)
OPENAI_BASE_URL=http://localhost:11434/v1

# API key for your LLM provider (use "ollama" for local Ollama instances)
OPENAI_API_KEY=your-api-key-here

# Disable telemetry and tracing (recommended for development)
OPENAI_AGENTS_DISABLE_TRACING=1
OPENAI_DISABLE_TELEMETRY=true

# --- Model Configuration ---
# Name of the LLM model to use
LOCAL_MODEL_NAME=qwen3-vl:235b-cloud

# Embedding model for vector search (if using embeddings)
LOCAL_EMBEDDING_MODEL=nomic-embed-text:latest

# --- Supabase Configuration ---
# Your Supabase project URL (found in Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (found in Supabase dashboard)
# WARNING: This is a public key - do NOT share your service role key
SUPABASE_KEY=your-supabase-anon-key-here
